      },
      "independent_expected": {
        "outcome": "solved",
        "termination": "feasible",
        "proposal_count": 2,
        "evaluated_candidate_count": 3,
        "selected_start_assignments": [
          {
            "a": 0,
            "b": 0
          },
          {
            "a": 2,
            "b": 0
          }
        ],
        "selected_scores": [
          2,
          0
        ],
        "rationale": "Baseline consumes evaluation 1. Moving A to 1 consumes evaluation 2 and leaves one overlap tick. Moving A to 2 consumes evaluation 3 and is immediately accepted as feasible even though the evaluation budget is now exhausted. Immediate feasible selection wins before B alternatives are examined.",
        "feasible_assignments": [
          {
            "a": 0,
            "b": 2
          },
          {
            "a": 2,
            "b": 0
          }
