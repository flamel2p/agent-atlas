    {
      "name": "dependency_deficit_and_iteration_precedence",
      "input": {
        "horizon": 4,
        "resources": [
          {
            "id": "bench",
            "capacity": 1
          }
        ],
        "tasks": [
          {
            "id": "b",
            "duration": 1,
            "earliest_start": 0,
            "latest_finish": 4,
            "requires": {},
            "after": [
              "a"
            ]
          },
          {
            "id": "a",
            "duration": 2,
            "earliest_start": 1,
            "latest_finish": 4,
            "requires": {},
            "after": []
          }
        ],
        "budget": {
          "iterations": 1,
          "evaluations": 1
        }
      },
      "independent_expected": {
        "outcome": "unsolved",
        "termination": "iteration_limit",
        "proposal_count": 1,
        "evaluated_candidate_count": 1,
        "selected_start_assignments": [
          {
            "a": 1,
            "b": 0
          }
        ],
        "selected_scores": [
          3
        ],
        "rationale": "A finishes at tick 3 while B starts at 0. The dependency excess is 3. Both budgets are already exhausted after the initial proposal, so iteration_limit has specified precedence.",
        "initial_violation_facts": [
          {
            "kind": "dependency",
            "affected": [
              "a",
              "b"
            ],
            "excess": 3
          }
        ],
        "feasible_assignments": [
          {
            "a": 1,
            "b": 3
          }
        ]
      }
    },
    {
