        ],
        "budget": {
          "iterations": 8,
          "evaluations": 200
        }
      },
      "independent_expected": {
        "outcome": "unsolved",
        "termination": "local_minimum",
        "proposal_count": 1,
        "evaluated_candidate_count": 2,
        "selected_start_assignments": [
          {
            "a": 1
          }
        ],
        "selected_scores": [
          1
        ],
        "rationale": "At start 1, finish 4 exceeds latest finish 3 by 1. The only other horizon-valid start is 0, which misses earliest start 1 by 1. Neither is feasible and equal score must not be selected.",
        "initial_violation_facts": [
          {
            "kind": "window",
            "affected": [
              "a"
            ],
            "excess": 1,
            "cause": "finish after latest finish"
          }
        ],
        "feasible_assignments": []
      }
