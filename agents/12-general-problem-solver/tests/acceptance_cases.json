        ],
        "selected_scores": [
          5
        ],
        "rationale": "CPU totals are 3 at tick 0 and 4 at tick 1 against capacity 2. GPU totals are 2 at ticks 0 and 1 against capacity 1. Four violations sum to 5, and the tick-1 CPU violation must name all three contributors.",
        "initial_violation_facts": [
          {
            "kind": "capacity",
            "resource": "cpu",
            "tick": 0,
            "affected": [
              "a",
              "b"
            ],
            "excess": 1
          },
          {
            "kind": "capacity",
            "resource": "cpu",
            "tick": 1,
            "affected": [
              "a",
              "b",
              "c"
            ],
            "excess": 2
          },
          {
            "kind": "capacity",
            "resource": "gpu",
            "tick": 0,
            "affected": [
              "a",
              "b"
            ],
            "excess": 1
          },
          {
            "kind": "capacity",
            "resource": "gpu",
            "tick": 1,
            "affected": [
              "a",
              "b"
            ],
            "excess": 1
          }
        ],
        "feasible_assignments": []
