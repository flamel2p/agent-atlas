{
  "source": "Agent 12 SPEC.md, read independently before any implementation inspection",
  "expected_field_names_are_test_metadata_not_runtime_serializer_assumptions": true,
  "cases": [
    {
      "name": "exact_windows_dependency_and_halfopen_capacity",
      "input": {
        "horizon": 4,
        "resources": [
          {
            "id": "bench",
            "capacity": 2
          }
        ],
        "tasks": [
          {
            "id": "b",
            "duration": 2,
            "earliest_start": 2,
            "latest_finish": 4,
            "requires": {
              "bench": 2
            },
            "after": [
              "a"
            ]
          },
          {
            "id": "a",
            "duration": 2,
            "earliest_start": 0,
            "latest_finish": 2,
            "requires": {
              "bench": 2
            },
            "after": []
          }
        ],
        "budget": {
          "iterations": 8,
          "evaluations": 200
        }
      },
      "independent_expected": {
        "outcome": "solved",
        "termination": "feasible",
        "proposal_count": 1,
        "evaluated_candidate_count": 1,
        "selected_start_assignments": [
          {
            "a": 0,
            "b": 2
          }
        ],
        "selected_scores": [
          0
        ],
        "rationale": "A finishes exactly at its latest finish. B starts at its earliest start and exactly at A finish. Each consumes full capacity on disjoint half-open intervals. Input task order must not affect canonical ID order.",
        "initial_violation_facts": [],
        "feasible_assignments": [
          {
            "a": 0,
            "b": 2
          }
        ]
      }
    },
    {
      "name": "duration_exceeds_window_is_valid_unsolved_input",
      "input": {
        "horizon": 4,
        "resources": [
          {
            "id": "bench",
            "capacity": 1
